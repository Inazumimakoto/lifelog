{
  "sourceLanguage": "ja",
  "strings": {
    "calendar.restricted": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではカレンダーへのアクセスが制限されています。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access is restricted on this device."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 캘린더 접근이 제한되어 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备已限制日历访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置已限制行事曆的取用。"
          }
        }
      }
    },
    "diary.currentLocation": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地を表示"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show current location"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위치 보기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示当前位置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示目前位置"
          }
        }
      }
    },
    "diary.locationSettings": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地を地図に表示するには、設定でlifelifyの位置情報の利用を許可してください。場所は検索でも選べます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To see your location on the map, allow lifelify to use your location in Settings. You can also search for a place."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위치를 지도에서 보려면 설정에서 lifelify가 위치를 사용하도록 허용해 주세요. 장소를 검색해서 선택할 수도 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要在地图上查看当前位置，请在“设置”中允许 lifelify 使用你的位置。你也可以搜索并选择地点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要在地圖上查看目前位置，請在「設定」中允許 lifelify 使用你的位置。你也可以搜尋並選取地點。"
          }
        }
      }
    },
    "health.connectPurpose": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歩数、睡眠、アクティビティをヘルスケアから読み込んで表示します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "lifelify reads and displays your steps, sleep, and activity from the Health app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강 앱에서 걸음 수, 수면 및 활동 데이터를 불러와 표시합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“健康”App 读取并显示你的步数、睡眠和活动数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從「健康」App 讀取並顯示你的步數、睡眠和活動資料。"
          }
        }
      }
    },
    "health.manageAccess": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取りを許可する項目は、ヘルスケアアプリのプロフィールにある「アプリ」からlifelifyを選んで変更できます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To change what lifelify can read, open your profile in the Health app, tap Apps, then choose lifelify."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기를 허용할 항목을 변경하려면 건강 앱의 프로필에서 ‘앱’을 탭한 다음 lifelify를 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要更改允许 lifelify 读取的数据，请打开“健康”App 的个人资料，轻点“App”，然后选择 lifelify。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要更改允許 lifelify 讀取的資料，請打開「健康」App 的個人檔案，點一下「App」，然後選擇 lifelify。"
          }
        }
      }
    },
    "health.requestFailed": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアへのアクセスを要求できませんでした。もう一度お試しください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to request access to Health. Please try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강 데이터 접근 권한을 요청할 수 없습니다. 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法请求访问“健康”数据。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法要求取用「健康」資料。請再試一次。"
          }
        }
      }
    },
    "home.lists": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定とタスクのリスト"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Event and task lists"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정 및 작업 목록"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日程和任务列表"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "行程和任務列表"
          }
        }
      }
    },
    "letters.notificationsOff": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已關閉"
          }
        }
      }
    },
    "letters.notificationsOn": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オン"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켬"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已开启"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已開啟"
          }
        }
      }
    },
    "location.restricted": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでは位置情報の利用が制限されています。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is restricted on this device."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 위치 정보 사용이 제한되어 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备已限制位置访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置已限制位置資訊的取用。"
          }
        }
      }
    },
    "notifications.configure": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知の受信を設定"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up notifications"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 수신 설정"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置通知"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定通知"
          }
        }
      }
    },
    "notifications.deniedMessage": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーや手紙の通知を受け取るには、デバイスの設定でlifelifyの通知をオンにしてください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To receive reminders and letter notifications, turn on notifications for lifelify in your device settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리 알림과 편지 알림을 받으려면 기기 설정에서 lifelify의 알림을 켜 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要接收提醒和信件通知，请在设备设置中打开 lifelify 的通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要接收提醒和信件通知，請在裝置設定中開啟 lifelify 的通知。"
          }
        }
      }
    },
    "notifications.deniedTitle": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知がオフです"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 꺼져 있습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已關閉"
          }
        }
      }
    },
    "notifications.openSettings": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知設定を開く"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open notification settings"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 설정 열기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开通知设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟通知設定"
          }
        }
      }
    },
    "notifications.unavailableMessage": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しばらくしてからもう一度お試しください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please try again later."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠시 후 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請稍後再試一次。"
          }
        }
      }
    },
    "notifications.unavailableTitle": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知を設定できませんでした"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to set up notifications"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 설정할 수 없습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法设置通知"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法設定通知"
          }
        }
      }
    },
    "weather.locationSettings": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地の天気を表示するには、設定でlifelifyの位置情報の利用を許可してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To see local weather, allow lifelify to use your location in Settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위치의 날씨를 보려면 설정에서 lifelify가 위치를 사용하도록 허용해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要查看当地天气，请在“设置”中允许 lifelify 使用你的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要查看當地天氣，請在「設定」中允許 lifelify 使用你的位置。"
          }
        }
      }
    },
    "weather.refresh": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天気を更新"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh weather"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날씨 새로 고침"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新天气"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新整理天氣"
          }
        }
      }
    },
    "weather.show": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地の天気を表示"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show local weather"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위치의 날씨 보기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示当地天气"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示當地天氣"
          }
        }
      }
    }
  },
  "version": "1.0"
}
