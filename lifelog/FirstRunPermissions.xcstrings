          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리 알림 및 편지 알림"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒和信件通知"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒和信件通知"
          }
        }
      }
    },
    "progress %lld/%lld": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
