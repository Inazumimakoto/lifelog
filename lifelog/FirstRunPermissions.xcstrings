            "value": "日程和任务提醒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "行程和任務提醒"
          }
        }
      }
    },
    "notifications.example2": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日記を書いていない日のリマインダー"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reminder if you haven’t written in your diary"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일기를 쓰지 않은 날의 미리 알림"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当天还没写日记时提醒你"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當天還沒寫日記時提醒你"
          }
        }
      }
    },
    "notifications.example3": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手紙が届いたときのお知らせ"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A notification when a letter arrives"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편지가 도착했을 때 알림"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信件送达时通知你"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "信件送達時通知你"
          }
        }
      }
    },
    "notifications.purpose": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知を使うと、アプリを閉じていてもお知らせを受け取れます。受け取る通知は、lifelifyの設定で選べます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications can reach you even when lifelify is closed. Choose which ones to receive in lifelify’s settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 사용하면 lifelify를 열지 않아도 소식을 받을 수 있습니다. 받을 알림은 lifelify 설정에서 선택할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用通知后，即使没有打开 lifelify，也能收到提醒。你可以在 lifelify 设置中选择要接收的通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟通知後，即使沒有打開 lifelify，也能收到提醒。你可以在 lifelify 設定中選擇要接收的通知。"
          }
        }
      }
    },
    "notifications.title": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
