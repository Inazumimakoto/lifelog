    "calendar.example1": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末の予定をlifelifyに表示"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See your device’s events in lifelify"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기의 일정을 lifelify에서 확인"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 lifelify 中查看设备上的日程"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 lifelify 中查看裝置上的行程"
          }
        }
      }
    },
    "calendar.example2": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーごとにカテゴリを選択"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a category for each calendar"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더별로 카테고리 선택"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为每个日历选择类别"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為每個行事曆選擇類別"
          }
        }
      }
    },
    "calendar.example3": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の予定をホームで確認"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See today’s events on Home"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈에서 오늘의 일정 확인"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在首页查看今天的日程"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在首頁查看今天的行程"
          }
        }
      }
    },
    "calendar.purpose": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "lifelifyは、端末のカレンダーから予定を読み込んでホームとカレンダーに表示します。読み込みにはカレンダーへのフルアクセスが必要です。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "lifelify reads events from your device’s calendars to show them on Home and Calendar. To read events, it needs full calendar access."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "lifelify는 기기 캘린더에서 일정을 읽어 홈과 캘린더에 표시합니다. 일정을 읽으려면 캘린더에 대한 전체 접근 권한이 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "lifelify 读取设备日历中的日程，并在“首页”和“日历”中显示。读取日程需要日历的完全访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "lifelify 會讀取裝置行事曆中的行程，並在「首頁」和「日曆」中顯示。讀取行程需要行事曆的完整取用權限。"
          }
        }
      }
    },
    "calendar.title": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末のカレンダーと連携"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your calendars"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 캘린더 연동"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接设备日历"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接裝置行事曆"
          }
        }
      }
    },
