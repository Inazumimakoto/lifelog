    "location.example3": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日記の地図で現在地を表示"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your current location on the diary map"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일기 지도에서 현재 위치 보기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在日记地图上显示当前位置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在日記地圖上顯示目前位置"
          }
        }
      }
    },
    "location.purpose": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報を使うと、ホームで現在地の天気を確認したり、日記の地図で今いる場所を探したりできます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location helps lifelify show local weather on Home and find you on the map when you add a place to your diary."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치 정보를 사용하면 홈에서 현재 위치의 날씨를 확인하고 일기에 장소를 추가할 때 지도에서 내 위치를 찾을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "lifelify 可以使用你的位置在首页显示当地天气，也可以在你向日记添加地点时，在地图上显示你的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "lifelify 可以使用你的位置在首頁顯示當地天氣，也可以在你為日記加入地點時，在地圖上顯示你的位置。"
          }
        }
      }
    },
    "location.title": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地の天気と地図"
