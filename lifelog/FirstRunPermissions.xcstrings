    "health.purpose": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアから読み取る項目を選べます。選んだデータは、日ごとの記録やグラフに表示します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which data lifelify can read from Health. It appears in your daily summaries and charts."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강 앱에서 읽도록 허용할 항목을 선택할 수 있습니다. 선택한 데이터는 일별 기록과 차트에 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以选择允许 lifelify 从“健康”读取哪些数据。这些数据会显示在每日记录和图表中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以選擇允許 lifelify 從「健康」讀取哪些資料。這些資料會顯示在每日記錄和圖表中。"
          }
        }
      }
    },
    "health.title": {
