        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當地天氣與地圖"
          }
        }
      }
    },
    "notifications.example1": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定やタスクのリマインダー"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders for events and tasks"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정 및 작업 미리 알림"
          }
        },
        "zh-Hans": {
          "stringUnit": {
