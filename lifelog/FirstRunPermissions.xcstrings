        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step %1$lld of %2$lld"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "총 %2$lld단계 중 %1$lld단계"
          }
        },
        "zh-Hans": {
