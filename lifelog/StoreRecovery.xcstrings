{
  "sourceLanguage": "ja",
  "strings": {
    "recovery.action": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録を復元"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recover records"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 복구"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原記錄"
          }
        }
      }
    },
    "recovery.archivedAt": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "退避された日時"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Date saved"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관된 날짜와 시간"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "副本保存时间"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "副本儲存時間"
          }
        }
      }
    },
    "recovery.archives": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "退避された記録"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved copies"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관된 기록"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留的记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留的記錄"
          }
        }
      }
    },
    "recovery.cancel": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "recovery.confirmTitle": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコピーから記録を復元しますか？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recover records from this copy?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 복사본에서 기록을 복구할까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要从此副本恢复记录吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要從這份副本復原記錄嗎？"
          }
        }
      }
    },
    "recovery.diaries": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日記"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diary entries"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日记"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "日記"
          }
        }
      }
    },
    "recovery.empty": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末には、復元に使える退避ファイルが見つかりませんでした。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No saved recovery files were found on this device."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 복구에 사용할 파일을 찾지 못했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此设备上未找到可用于恢复的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置上找不到可用於復原的檔案。"
          }
        }
      }
    },
    "recovery.events": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Events"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日程"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "行程"
          }
        }
      }
    },
    "recovery.explanation": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今ある記録を優先し、このコピーから不足している記録を追加します。退避された元のファイルも端末に残ります。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your current records take priority. Missing records will be added from this copy. The original recovery files will stay on this device."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 기록을 우선으로 유지하고, 이 복사본에서 누락된 기록을 추가합니다. 보관된 원본 파일도 기기에 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将优先保留现有记录，并从此副本补入缺少的记录。原始恢复文件也会保留在设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統會優先保留現有記錄，並從這份副本補上缺少的記錄。原始復原檔案也會保留在裝置上。"
          }
        }
      }
    },
    "recovery.inspecting": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録のコピーを読み込んでいます…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading a copy of your records…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 복사본을 읽는 중…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取记录的副本…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在讀取記錄的副本…"
          }
        }
      }
    },
    "recovery.invalidDatabase": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコピーを読み出せませんでした。復元をご希望の場合は、設定の「ご意見・不具合報告」からご連絡ください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This copy could not be read. For help recovering it, contact us through feedback in Settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 복사본을 읽을 수 없습니다. 복구에 도움이 필요하시면 설정의 의견 및 오류 신고를 통해 연락해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取此副本。如需协助恢复，请通过设置中的反馈功能联系我们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取這份副本。如需復原協助，請透過設定中的意見回饋與我們聯絡。"
          }
        }
      }
    },
    "recovery.missingDatabase": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日時のデータベース本体が見つかりません。別の日時の記録があれば、そちらをご確認ください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database file for this date is missing. If another copy is listed, check that date."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 날짜의 데이터베이스 파일을 찾을 수 없습니다. 다른 날짜의 복사본이 있으면 확인해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到此日期的数据库文件。如有其他日期的副本，请查看其他副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到這個日期的資料庫檔案。如果有其他日期的副本，請查看其他副本。"
          }
        }
      }
    },
    "recovery.noAdditions": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加できる記録はありませんでした。現在の記録をそのまま利用できます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There were no records to add. You can continue using your current records."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가할 기록이 없습니다. 현재 기록을 계속 사용할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可添加的记录。您可以继续使用现有记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可加入的記錄。您可以繼續使用現有記錄。"
          }
        }
      }
    },
    "recovery.noRecords": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコピーから読み出せた記録は0件です。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This copy contains no readable records."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 복사본에서 읽을 수 있는 기록이 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此副本中没有可读取的记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份副本中沒有可讀取的記錄。"
          }
        }
      }
    },
    "recovery.other": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その他の記録・設定"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other records and settings"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기타 기록 및 설정"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他记录与设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他記錄與設定"
          }
        }
      }
    },
    "recovery.preview": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み出せた記録"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records found in this copy"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사본에서 읽은 기록"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从副本中读取的记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從副本讀取的記錄"
          }
        }
      }
    },
    "recovery.reloadFailed": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元した記録は保存されました。lifelifyを終了して、もう一度開いてからご確認ください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recovered records have been saved. Quit lifelify and open it again to see them."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구한 기록을 저장했습니다. lifelify를 종료한 후 다시 열어 확인해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复的记录已保存。请退出 lifelify 后重新打开查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原的記錄已儲存。請結束 lifelify，再重新開啟查看。"
          }
        }
      }
    },
    "recovery.restoring": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録を復元しています…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovering your records…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록을 복구하는 중…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在恢复记录…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在復原記錄…"
          }
        }
      }
    },
    "recovery.retry": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度確認"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check again"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 확인"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新检查"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新檢查"
          }
        }
      }
    },
    "recovery.saveFailed": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録の復元を完了できませんでした。端末の空き容量を確認してから、もう一度お試しください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery could not be completed. Check the available storage on your device and try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 복구를 완료할 수 없습니다. 기기의 저장 공간을 확인한 후 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能完成记录恢复。请检查设备可用空间后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法完成記錄復原。請確認裝置的可用空間，再試一次。"
          }
        }
      }
    },
    "recovery.scanFailed": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存場所を開けませんでした。端末のロックを解除して、もう一度お試しください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The storage location could not be opened. Unlock your device and try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 위치를 열 수 없습니다. 기기의 잠금을 해제하고 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开存储位置。请解锁设备后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟儲存位置。請解鎖裝置後再試一次。"
          }
        }
      }
    },
    "recovery.scanning": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末の復元候補を探しています…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking for saved copies on this device…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 보관된 복사본을 찾는 중…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在查找此设备上保留的副本…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在尋找此裝置上保留的副本…"
          }
        }
      }
    },
    "recovery.select": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容を確認したい日時を選んでください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a date to see which records that copy contains."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내용을 확인할 날짜와 시간을 선택해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择日期和时间以查看该副本中的记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇日期與時間，查看該份副本中的記錄。"
          }
        }
      }
    },
    "recovery.success.count %lld": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld件の記録を復元しました。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records recovered: %lld."
          }
        },
        "ko": {
