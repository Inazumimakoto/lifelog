{
  "sourceLanguage": "ja",
  "strings": {
    "startup.unavailable.title": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存データを開けませんでした"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to open your records"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 기록을 열 수 없습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开已保存的记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟已儲存的記錄"
          }
        }
      }
    },
    "startup.unavailable.message": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録を保護するため、読み込みを停止しました。iPhoneまたはiPadのロックを解除して、もう一度お試しください。改善しない場合は、アプリを削除せずに開発者にお問い合わせください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading has paused to protect your records. Unlock your device and try again. If the problem continues, keep the app installed and contact the developer."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록을 보호하기 위해 불러오기를 중단했습니다. 기기의 잠금을 해제한 후 다시 시도해 주세요. 문제가 계속되면 앱을 삭제하지 말고 개발자에게 문의해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为保护您的记录，已暂停读取。请解锁设备后重试。如果问题仍然存在，请保留此应用并联系开发者。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為保護您的記錄，已暫停讀取。請解鎖裝置後再試一次。如果問題持續發生，請保留此 App 並聯絡開發者。"
          }
        }
      }
    },
    "startup.retry": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度試す"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Again"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 시도"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再試一次"
          }
        }
      }
    },
    "startup.recoveryFound": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前の記録のファイルが見つかりました"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A previous data file was found"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 기록 파일을 찾았습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已找到以前的记录文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已找到先前的記錄檔案"
          }
        }
      }
    },
    "startup.review": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録を確認"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review Records"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 확인"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看記錄"
          }
        }
      }
    },
    "startup.recoveryHint": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末にあるファイルから、復元できる記録を確認できます。あとから設定の「以前の記録を復元」でも確認できます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check which records can be recovered on this device. You can also do this later in Settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 복원할 수 있는 기록을 확인하세요. 나중에 설정에서도 확인할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以查看这台设备上可恢复的记录，也可以稍后在设置中查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以查看這部裝置上可回復的記錄，也可以稍後在設定中查看。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
