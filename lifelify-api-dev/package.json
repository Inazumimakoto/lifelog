{
  "name": "lifelify-api-dev",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "deploy:links": "wrangler deploy --config wrangler.link.jsonc --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "setup:dev": "node scripts/setup-dev-token.mjs",
    "shopping:list": "node scripts/shopping.mjs list",
    "shopping:add": "node scripts/shopping.mjs add",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.28.0",
    "hono": "^4.13.13",
    "jose": "6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261006.1-alpha",
    "typescript": "^7.0.2",
    "wrangler": "^4.110.0"
  },
  "overrides": {
    "agents": {
      "@modelcontextprotocol/client": "2.3.1",
      "@modelcontextprotocol/sdk": "1.32.1"
    }
  }
}
