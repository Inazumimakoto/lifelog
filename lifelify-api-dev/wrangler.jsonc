{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lifelify-api-dev",
  "preview_urls": false,
  "main": "src/index.ts",
  "account_id": "b2dd7cb0e1123d5743f156066e70ed24",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  },
  "vars": {
    "AUTH_MODE": "apple",
    "APPLE_APP_ID": "com.inazumimakoto.lifelog",
    "APP_APPROVAL_ENABLED": "true",
    "APPLE_SERVICE_ID": "com.inazumimakoto.lifelog.web.dev",
    "APPLE_TEAM_ID": "V7XG8HDQL4",
    "APPLE_KEY_ID": "89TL78B5D3"
  },
  "secrets": {
    "required": ["DEV_API_TOKEN"]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "3ffcd919c29b45108426753c9fae3e5e"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lifelify-dev",
      "database_id": "bf8ba31b-c5d8-4315-a45e-653c1a8cbdb0",
      "remote": true
    }
  ]
}
